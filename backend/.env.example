# Copia este archivo a `.env` y rellena los valores. `.env` NO se versiona.

# Conexión a la base de datos.
# Desarrollo (SQLite):
DATABASE_URL="file:./dev.db"
# Producción (PostgreSQL), ejemplo:
# DATABASE_URL="postgresql://usuario:password@host:5432/panuelo?schema=public"

# Puerto del servidor NestJS (opcional, por defecto 3000).
PORT=3000

# Contraseña del SUPERADMIN que crea `prisma/seed.ts`.
# Obligatoria para poder correr el seed; no uses contraseñas hardcodeadas.
SEED_SUPERADMIN_PASSWORD="cambia-esto-en-local"
