# Copia este archivo a `.env` y rellena los valores. `.env` NO se versiona.

# Conexión a la base de datos (PostgreSQL en todos los entornos).
# Desarrollo: el contenedor de `docker compose up -d` (raíz del monorepo)
# expone PostgreSQL en el puerto 5433 del host con estas credenciales.
DATABASE_URL="postgresql://panuelo:panuelo@localhost:5433/panuelo?schema=public"
# Producción: la cadena que entregue el proveedor (Render, Neon, Supabase…), p. ej.:
# DATABASE_URL="postgresql://usuario:password@host:5432/panuelo?schema=public&sslmode=require"

# Puerto del servidor NestJS (opcional, por defecto 3000).
PORT=3000

# Orígenes permitidos por CORS, separados por comas (opcional).
# Sin esta variable se permite cualquier origen (solo para desarrollo).
# CORS_ORIGINS="https://app.tudominio.com,https://admin.tudominio.com"

# --- Autenticación (JWT) ---
# Secreto para firmar los tokens. OBLIGATORIO. Usa una cadena larga y aleatoria,
# p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
# Caducidad del token (formato de `ms`/`jsonwebtoken`). Opcional, por defecto 7d.
JWT_EXPIRES_IN="7d"

# --- Seed ---
# Contraseña del SUPERADMIN que crea `prisma/seed.ts`.
# Obligatoria para poder correr el seed; no uses contraseñas hardcodeadas.
SEED_SUPERADMIN_PASSWORD="cambia-esto-en-local"
