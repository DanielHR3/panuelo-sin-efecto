// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                 String               @id @default(uuid())
  nombre             String
  email              String               @unique
  passwordHash       String
  rol                String               // 'SUPERADMIN', 'LIGA_ADMIN', 'ARBITRO'

  ligasPropias       Liga[]               @relation("PropietarioLiga")
  asignaciones       AsignacionArbitral[]
  eventosRegistrados EventoPartido[]      @relation("ArbitroRegistrador")
  discrepanciasResueltas DiscrepanciaEvento[]

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Liga {
  id            String      @id @default(uuid())
  nombre        String

  // HU-1.1: identidad y reglas generales de la liga. Las banderas deciden
  // qué le exige la PWA al árbitro: elegir MVP al finalizar y ofrecer el
  // evento INTERCEPCION (PICK_SIX sigue disponible siempre porque anota).
  logoUrl                String?
  registraMvp            Boolean @default(true)
  registraIntercepciones Boolean @default(true)

  propietarioId String
  propietario   Usuario     @relation("PropietarioLiga", fields: [propietarioId], references: [id])
  
  categorias    Categoria[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Categoria {
  id            String      @id @default(uuid())
  nombre        String      // Ej. Varonil, Femenil, Mixto
  
  ligaId        String
  liga          Liga        @relation(fields: [ligaId], references: [id])
  
  equipos       Equipo[]
  partidos      Partido[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Equipo {
  id                String          @id @default(uuid())
  nombre            String
  colorPrimario     String?
  
  categoriaId       String
  categoria         Categoria       @relation(fields: [categoriaId], references: [id])
  
  jugadores         Jugador[]
  
  partidosLocal     Partido[]       @relation("EquipoLocal")
  partidosVisitante Partido[]       @relation("EquipoVisitante")
  
  eventos           EventoPartido[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Jugador {
  id            String          @id @default(uuid())
  nombre        String
  numeroJersey  String
  
  equipoId      String
  equipo        Equipo          @relation(fields: [equipoId], references: [id])
  
  eventos       EventoPartido[]
  partidosMvp   Partido[]       @relation("PartidoMvp")

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Partido {
  id                String               @id @default(uuid())
  fechaHora         DateTime
  dificultad        String               // REGULAR, MEDIO, COMPLICADO
  estado            String               // PROGRAMADO, EN_CURSO, FINALIZADO
  // Caché denormalizada del marcador. La fuente de verdad es la tabla
  // EventoPartido (Caja Negra): estos campos se recalculan en la misma
  // transacción que inserta cada evento. No mutar directamente por API.
  marcadorLocal     Int                  @default(0)
  marcadorVisitante Int                  @default(0)
  
  categoriaId       String
  categoria         Categoria            @relation(fields: [categoriaId], references: [id])
  
  equipoLocalId     String
  equipoLocal       Equipo               @relation("EquipoLocal", fields: [equipoLocalId], references: [id])
  
  equipoVisitanteId String
  equipoVisitante   Equipo               @relation("EquipoVisitante", fields: [equipoVisitanteId], references: [id])
  
  asignaciones      AsignacionArbitral[]
  eventos           EventoPartido[]

  // MVP del partido (HU-2.5): se elige una vez FINALIZADO, entre el roster
  // de cualquiera de los dos equipos. Nullable porque no todo partido lo
  // tiene todavía (obligatorio en el flujo del árbitro, pero editable
  // después, así que nunca es un requisito a nivel de fila).
  mvpJugadorId      String?
  mvpJugador        Jugador?             @relation("PartidoMvp", fields: [mvpJugadorId], references: [id])

  discrepancias     DiscrepanciaEvento[]

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model AsignacionArbitral {
  partidoId     String
  partido       Partido  @relation(fields: [partidoId], references: [id])
  
  arbitroId     String
  arbitro       Usuario  @relation(fields: [arbitroId], references: [id])
  
  rolEnCampo    String   // Referee, Umpire, Line Judge
  
  @@id([partidoId, arbitroId])
}

model EventoPartido {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  tipoEvento    String   // INICIO_MITAD, FIN_MITAD, TD, PAT1, PAT2, SAFETY, PICK_SIX, TIMEOUT, FALTA_PERSONAL, EXPULSION, INTERCEPCION, SACK, UNDO_LAST_ACTION

  // Id generado por el dispositivo del árbitro. Permite que el reintento de la
  // cola offline sea idempotente: (partidoId, clientEventId) es único, así que
  // reenviar el mismo evento no duplica puntos. Nulo para eventos creados
  // directamente en el servidor.
  clientEventId String?

  // Reconciliación entre árbitros (HU-2.6): flag suave, la fila nunca se
  // borra (Caja Negra) — solo se excluye del cálculo del marcador cuando un
  // admin resuelve una discrepancia descartando este evento.
  descartado    Boolean  @default(false)

  partidoId     String
  partido       Partido  @relation(fields: [partidoId], references: [id])

  equipoId      String?
  equipo        Equipo?  @relation(fields: [equipoId], references: [id])

  jugadorId     String?
  jugador       Jugador? @relation(fields: [jugadorId], references: [id])

  arbitroId     String
  arbitro       Usuario  @relation("ArbitroRegistrador", fields: [arbitroId], references: [id])

  discrepanciasComoA         DiscrepanciaEvento[] @relation("DiscrepanciaEventoA")
  discrepanciasComoB         DiscrepanciaEvento[] @relation("DiscrepanciaEventoB")
  discrepanciasDescartadoEn  DiscrepanciaEvento[] @relation("DiscrepanciaEventoDescartado")

  @@unique([partidoId, clientEventId])
  @@index([partidoId, timestamp])
}

model DiscrepanciaEvento {
  id                 String    @id @default(uuid())

  partidoId          String
  partido            Partido       @relation(fields: [partidoId], references: [id])

  eventoAId          String
  eventoA            EventoPartido @relation("DiscrepanciaEventoA", fields: [eventoAId], references: [id])

  eventoBId          String
  eventoB            EventoPartido @relation("DiscrepanciaEventoB", fields: [eventoBId], references: [id])

  estado             String    // PENDIENTE, RESUELTA

  // Nulo si se resolvió como "mantener ambos" (falso positivo de la detección).
  eventoDescartadoId String?
  eventoDescartado   EventoPartido? @relation("DiscrepanciaEventoDescartado", fields: [eventoDescartadoId], references: [id])

  resueltoPorId      String?
  resueltoPor        Usuario?  @relation(fields: [resueltoPorId], references: [id])
  resolvedAt         DateTime?

  createdAt          DateTime  @default(now())

  // Backstop de base de datos (HU-2.6, finding 2): además de la lectura
  // fresca dentro de la transacción en eventos.service.ts, esta restricción
  // impide que dos filas repitan el mismo par de eventos si algo lograra
  // colarse igual (p. ej. datos ya duplicados de antes de este fix).
  @@unique([eventoAId, eventoBId])
  @@index([partidoId, estado])
}
